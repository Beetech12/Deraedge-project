# Copy to .env only if it does not already exist; never commit .env.
# Direct node startup and payments:check load the repository .env automatically.
# Existing shell environment variables take precedence. Restart after changes.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=.data/enrollments.sqlite
# Vercel requires durable Postgres (connect Neon in Project > Storage).
# Set DATABASE_URL privately in Vercel, never in frontend code or Git.
# Local development uses SQLite if DATABASE_URL is absent.
DATABASE_URL=
# Obtain this privately from your Paystack dashboard. Never place it in js/.
PAYSTACK_SECRET_KEY=
# Enable only currencies activated on your Paystack account, e.g. NGN,USD.
PAYMENT_CURRENCIES=NGN
# After confirming activation with Paystack for this account/mode, list supported
# currencies here (NGN for a naira-only account). Blank blocks checkout. A balance
# authentication check alone does not prove currency eligibility.
PAYSTACK_CONFIRMED_CURRENCIES=
# To add NGN: confirm provider support, add NGN to BOTH currency lists,
# and supply all three approved fixed prices. No exchange rate is inferred.
# NGN amounts are in KOBO. Leave blank until your fixed naira prices are approved.
PRICE_FOUNDATION_NGN=
PRICE_PROFESSIONAL_NGN=
PRICE_MASTERY_NGN=
# USD amounts are in CENTS and match the existing site prices.
PRICE_FOUNDATION_USD=10000
PRICE_PROFESSIONAL_USD=20000
PRICE_MASTERY_USD=50000
# These paths connect the existing policy pages for same-origin localhost tests.
# Review and publish them before production. Set PUBLIC_URL to your real HTTPS
# origin and these variables to the real published HTTPS policy URLs.
# Do not use placeholder domains. Paystack webhooks need a reachable HTTPS URL:
# <your published origin>/api/paystack/webhook (localhost is not reachable).
TERMS_URL=/deraedge-enroll/terms.html
PRIVACY_URL=/deraedge-enroll/privacy.html
REFUND_URL=/deraedge-enroll/refund.html
POLICY_VERSION=2026-09-28.1
# Requires HTTPS PUBLIC_URL and a live secret key; false prevents live charges.
ALLOW_LIVE_PAYMENTS=false

# Automatic contact / partnership email (Gmail defaults; other SMTP servers also work).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=okolochinedu10@gmail.com
# Use a Google App Password with 2-Step Verification, NOT the normal account password.
SMTP_PASSWORD=
SMTP_FROM=okolochinedu10@gmail.com
