PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
DATABASE_PATH=.data/enrollments.sqlite
# Obtain this privately from your Paystack dashboard. Never place it in js/.
PAYSTACK_SECRET_KEY=
# Enable only currencies activated on your Paystack account, e.g. NGN,USD.
PAYMENT_CURRENCIES=USD
# NGN amounts are in KOBO. Leave blank until your fixed naira prices are approved.
PRICE_FOUNDATION_NGN=
PRICE_PROFESSIONAL_NGN=
PRICE_MASTERY_NGN=
# USD amounts are in CENTS and match the existing site prices.
PRICE_FOUNDATION_USD=10000
PRICE_PROFESSIONAL_USD=20000
PRICE_MASTERY_USD=50000
# Publish your business policies, then set their full HTTPS URLs here.
TERMS_URL=
PRIVACY_URL=
REFUND_URL=
POLICY_VERSION=1
# Requires HTTPS PUBLIC_URL and a live secret key; false prevents live charges.
ALLOW_LIVE_PAYMENTS=false
